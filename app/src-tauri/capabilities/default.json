{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the shell webview in main window",
  "windows": ["main"],
  "webviews": ["shell"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "opener:default",
    "dialog:allow-open",
    "updater:default",
    "process:allow-restart"
  ]
}
